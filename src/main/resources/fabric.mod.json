{
	"schemaVersion": 1,
	"id": "mcweapons",
	"version": "${version}",
	"name": "Minecraft Weapons",
	"description": "Animated guns with a first-person viewmodel, built on GeckoLib.",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.noxloveya.mcweapons.McWeapons"
		],
		"client": [
			"com.noxloveya.mcweapons.client.McWeaponsClient"
		],
		"lambdynlights:initializer": [
			"com.noxloveya.mcweapons.client.compat.LambDynLightsCompat"
		]
	},
	"mixins": [
		{
			"config": "mcweapons.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.164.0",
		"geckolib": ">=5.5.7"
	}
}
